# Dockerfile for Rockchip RK3588 / RK3576 / RK3566
# Build context: staged by orchestrator/utils/build_context.py (modules/, scripts/, docker/entrypoint.sh).
#
# Toolchains, each in its own venv because their pins conflict:
#   /opt/venv        llama.cpp GGUF conversion (convert_hf_to_gguf.py, torch 2.11 CPU)
#   /opt/venv-rkllm  RKLLM-Toolkit (torch 2.6, transformers 5.8)
#   /opt/venv-rknn   RKNN-Toolkit2 (torch <= 2.4)
# Debian Bookworm (Python 3.11) because the Rockchip wheels exist only for cp310-cp312.

FROM debian:bookworm-slim

LABEL maintainer="LLM Cross-Compiler Framework"
LABEL description="Model conversion for Rockchip RK3588/RK3576 (RKLLM, GGUF) and RK3566 (GGUF)"
LABEL target.architecture="aarch64"

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG LLAMA_CPP_TAG=v0.6.0
ARG RKLLM_VERSION=1.3.1
ARG RKLLM_WHEEL_SHA256=ce58a734bf50289e059c31a057dc494fb43d8a791acb002c60f02145c3c39b71
ARG RKNN_TOOLKIT2_VERSION=2.3.2

ENV DEBIAN_FRONTEND=noninteractive
ENV BUILD_CACHE_DIR=/build-cache
ENV LLAMA_CPP_PATH=/usr/src/llama.cpp
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# libgl1/libglib2.0-0: opencv (rknn-toolkit2); gosu: privilege drop that keeps PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates curl gosu \
        python3 python3-venv python3-dev pkg-config libgomp1 libgl1 libglib2.0-0 \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# --- llama.cpp host tools (convert, quantize, imatrix; completion/perplexity for quality checks) ---
RUN git clone --depth 1 -b "${LLAMA_CPP_TAG}" https://github.com/ggml-org/llama.cpp.git "${LLAMA_CPP_PATH}" \
    && cmake -S "${LLAMA_CPP_PATH}" -B "${LLAMA_CPP_PATH}/build" \
        -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DLLAMA_CURL=OFF \
        -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF \
    && cmake --build "${LLAMA_CPP_PATH}/build" -j"$(nproc)" \
        --target llama-quantize llama-imatrix llama-completion llama-perplexity \
    && rm -rf "${LLAMA_CPP_PATH}/build/CMakeFiles" "${LLAMA_CPP_PATH}/.git"

# --- GGUF venv (default python3 on PATH) ---
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "${VIRTUAL_ENV}" \
    && "${VIRTUAL_ENV}/bin/pip" install --upgrade pip setuptools wheel \
    && "${VIRTUAL_ENV}/bin/pip" install -r "${LLAMA_CPP_PATH}/requirements/requirements-convert_hf_to_gguf.txt" \
    && "${VIRTUAL_ENV}/bin/pip" install "${LLAMA_CPP_PATH}/gguf-py"
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# --- RKLLM venv (LLMs on the RK3588/RK3576 NPU) ---
RUN python3 -m venv /opt/venv-rkllm \
    && /opt/venv-rkllm/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv-rkllm/bin/pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cpu \
    && /opt/venv-rkllm/bin/pip install \
        "rkllm-toolkit @ https://raw.githubusercontent.com/airockchip/rknn-llm/release-v${RKLLM_VERSION}/rkllm-toolkit/packages/rkllm_toolkit-${RKLLM_VERSION}-cp311-cp311-linux_x86_64.whl#sha256=${RKLLM_WHEEL_SHA256}" \
    && /opt/venv-rkllm/bin/python -c "from rkllm.api import RKLLM; RKLLM(); print('RKLLM toolkit ok')"
ENV RKLLM_PYTHON=/opt/venv-rkllm/bin/python

# --- RKNN venv (vision/voice models via ONNX on the NPU) ---
# rknn-toolkit2 2.3.2 imports pkg_resources (gone in setuptools >= 81) and onnx.mapping (gone after onnx 1.16);
# its own requirements leave both unbounded.
RUN python3 -m venv /opt/venv-rknn \
    && /opt/venv-rknn/bin/pip install --upgrade pip wheel "setuptools<81" \
    && /opt/venv-rknn/bin/pip install torch==2.4.0 --index-url https://download.pytorch.org/whl/cpu \
    && /opt/venv-rknn/bin/pip install "rknn-toolkit2==${RKNN_TOOLKIT2_VERSION}" "onnx==1.16.2" \
    && /opt/venv-rknn/bin/python -c "from rknn.api import RKNN; RKNN(verbose=False); print('RKNN toolkit ok')"
ENV RKNN_PYTHON=/opt/venv-rknn/bin/python

RUN echo "${LLAMA_CPP_TAG}" > "${LLAMA_CPP_PATH}/.llama_cpp_tag"

# --- Framework modules and user ---
WORKDIR /app
COPY modules/ ./modules/
COPY scripts/ ./scripts/
RUN find modules scripts -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod +x {} +

RUN groupadd -g "${GROUP_ID}" llmbuilder \
    && useradd -u "${USER_ID}" -g llmbuilder -d /app -s /bin/bash llmbuilder \
    && mkdir -p "${BUILD_CACHE_DIR}" \
    && chown -R llmbuilder:llmbuilder /app "${BUILD_CACHE_DIR}"

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR ${BUILD_CACHE_DIR}
USER llmbuilder
ENTRYPOINT ["/entrypoint.sh"]
CMD ["interactive"]
