{
  // GitHub Codespaces / Dev Containers: the framework's dev setup (Python 3.13 + uv, Rust for rust/, Docker for builds).
  "name": "LLM Cross-Compiler Framework",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "pip install --user uv==0.11.32 && uv sync --frozen --extra gui --group dev",
  "containerEnv": { "QT_QPA_PLATFORM": "offscreen" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "rust-lang.rust-analyzer"]
    }
  }
}
