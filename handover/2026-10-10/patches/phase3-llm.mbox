@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""
+A thin tool loop on top of LLMClient.chat().
+
+The history only grows: assistant turns are appended exactly as the provider returned them, the tools array is
+the same object on every step, and each step's tool results go back together (one user turn on Claude).
+That keeps the prompt cache warm and Claude's preserved thinking valid across the loop.
+"""
+
+from dataclasses import dataclass, field
+from typing import Any, Callable, List, Optional
+
+from orchestrator.llm.errors import Refused
+from orchestrator.llm.types import ChatRequest, ChatResult, Message, ToolSpecLLM, Usage, tool_result_text
+from orchestrator.utils.helpers import redact_secrets
+from orchestrator.utils.untrusted import wrap_untrusted
+
+ExecuteTool = Callable[[str, dict], Any]
+
+
+@dataclass
+class ToolLoopResult:
+    text: str
+    stop: str                      # end | max_tokens | refusal | max_steps
+    steps: int
+    new_messages: List[Message] = field(default_factory=list)  # append these to the conversation
+    results: List[ChatResult] = field(default_factory=list)
+    usage: Usage = field(default_factory=Usage)
+    refusal: Optional[Refused] = None
+    parsed: Any = None
+
+
+def run_tool_loop(client: Any, request: ChatRequest, execute_tool: ExecuteTool, max_steps: int = 8) -> ToolLoopResult:
+    """Runs model turns and tool calls until the model answers, refuses, or max_steps model turns were made.
+    `execute_tool(name, arguments)` returns the result (text, dict or pydantic model) or raises on failure."""
+    history = list(request.messages)
+    new: List[Message] = []
+    results: List[ChatResult] = []
+    usage = Usage()
+    tools = request.tools  # the very same list on every step
+    for step in range(1, max_steps + 1):
+        step_request = request.model_copy(update={"messages": list(history), "tools": tools})
+        try:
+            result = client.chat(step_request)
+        except Refused as e:
+            return ToolLoopResult(text="", stop="refusal", steps=step, new_messages=new, results=results,
+                                  usage=usage, refusal=e)
+        results.append(result)
+        usage = usage + result.usage
+        history.extend(result.new_messages)
+        new.extend(result.new_messages)
+        if result.stop != "tool_use" or not result.tool_calls:
+            return ToolLoopResult(text=result.text, stop=result.stop, steps=step, new_messages=new,
+                                  results=results, usage=usage, parsed=result.parsed)
+        for call in result.tool_calls:
+            if call.parse_error:
+                outcome = Message.tool_result(call.id, f"Invalid arguments for {call.name}: {call.parse_error}",
+                                              is_error=True)
+            else:
+                try:
+                    outcome = Message.tool_result(call.id, tool_result_text(execute_tool(call.name, call.arguments)))
+                except Exception as e:  # the model sees the failure and can adapt
+                    outcome = Message.tool_result(call.id, redact_secrets(str(e)) or type(e).__name__, is_error=True)
+            history.append(outcome)
+            new.append(outcome)
+    last = results[-1] if results else None
+    return ToolLoopResult(text=last.text if last else "", stop="max_steps", steps=max_steps, new_messages=new,
+                          results=results, usage=usage)
+
+
+def tool_specs_from_registry(registry: Any, names: Optional[List[str]] = None) -> List[ToolSpecLLM]:
+    """The registry's tools as model tool definitions, in a stable order (sorted by name)."""
+    specs = [s for s in registry.list() if names is None or s.name in names]
+    return [ToolSpecLLM.from_tool_spec(s) for s in sorted(specs, key=lambda s: s.name)]
+
+
+def make_registry_executor(registry: Any, ctx: Any, wrap: bool = True) -> ExecuteTool:
+    """execute_tool for run_tool_loop that goes through ToolRegistry.call (validation, permissions, audit).
+    Tool output can carry external text (logs, crawled pages), so it is wrapped as untrusted data."""
+    def execute(name: str, arguments: dict) -> str:
+        output = tool_result_text(registry.call(name, arguments, ctx))
+        return wrap_untrusted(output, source=f"tool:{name}") if wrap else output
+    return execute
diff --git a/orchestrator/llm/types.py b/orchestrator/llm/types.py
new file mode 100644
index 0000000..b04b89a
--- /dev/null
+++ b/orchestrator/llm/types.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""
+Provider-neutral request/response types of the LLM layer.
+
+Conversations are append-only: a ChatResult carries the provider's own assistant message (`native`), which
+goes back into the history unchanged. Claude binds its thinking blocks to the exact conversation prefix, and
+every provider's prompt cache is a prefix match, so earlier turns must never be rebuilt or edited.
+"""
+
+import json
+from typing import Any, Dict, List, Literal, Optional, Type, Union
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+Role = Literal["user", "assistant", "tool", "system"]
+Effort = Literal["low", "medium", "high", "xhigh", "max"]
+Task = Literal["chat", "tools", "json", "healing"]
+StopReason = Literal["end", "tool_use", "max_tokens", "refusal"]
+
+TASKS: tuple = ("chat", "tools", "json", "healing")
+EFFORTS: tuple = ("low", "medium", "high", "xhigh", "max")
+
+
+class NativeMessage(BaseModel):
+    """A provider's assistant turn exactly as returned (thinking blocks, reasoning items, ids).
+    Only the adapter family that produced it reads `payload`; others fall back to the neutral fields."""
+    model_config = ConfigDict(frozen=True)
+
+    family: str
+    payload: Dict[str, Any]
+
+    def __repr__(self) -> str:  # payloads can be large; keep logs readable
+        return f"NativeMessage(family={self.family!r})"
+
+
+class ToolCall(BaseModel):
+    id: str
+    name: str
+    arguments: Dict[str, Any] = Field(default_factory=dict)
+    parse_error: Optional[str] = None  # the model sent arguments that are not a JSON object
+
+
+class Message(BaseModel):
+    """One turn. `content` is plain text or a list of neutral blocks:
+    {"type": "text", "text": ...} or {"type": "image", "media_type": "image/png", "data": <base64>}."""
+    role: Role
+    content: Union[str, List[Dict[str, Any]]] = ""
+    tool_call_id: Optional[str] = None   # role == "tool": the call this result answers
+    is_error: bool = False               # role == "tool": the tool failed
+    tool_calls: List[ToolCall] = Field(default_factory=list)  # role == "assistant"
+    native: Optional[NativeMessage] = None                    # role == "assistant"
+
+    @field_validator("content")
+    @classmethod
+    def _blocks_have_type(cls, value):
+        if isinstance(value, list):
+            for block in value:
+                if not isinstance(block, dict) or block.get("type") not in ("text", "image"):
+                    raise ValueError("content blocks must be {'type': 'text'|'image', ...}")
+        return value
+
+    def text(self) -> str:
+        if isinstance(self.content, str):
+            return self.content
+        return "".join(b.get("text", "") for b in self.content if b.get("type") == "text")
+
+    @classmethod
+    def user(cls, text: str) -> "Message":
+        return cls(role="user", content=text)
+
+    @classmethod
+    def tool_result(cls, call_id: str, content: str, is_error: bool = False) -> "Message":
+        return cls(role="tool", tool_call_id=call_id, content=content, is_error=is_error)
+
+
+class ToolSpecLLM(BaseModel):
+    """A tool as the model sees it. `input_schema` is a JSON schema of an object."""
+    name: str = Field(pattern=r"^[A-Za-z0-9_-]{1,64}$")
+    description: str = ""
+    input_schema: Dict[str, Any] = Field(default_factory=lambda: {"type": "object", "properties": {}})
+    strict: bool = True
+
+    @classmethod
+    def from_model(cls, name: str, description: str, input_model: Type[BaseModel],
+                   strict: bool = True) -> "ToolSpecLLM":
+        return cls(name=name, description=description, input_schema=input_model.model_json_schema(), strict=strict)
+
+    @classmethod
+    def from_tool_spec(cls, spec) -> "ToolSpecLLM":
+        """From an orchestrator.tools.registry.ToolSpec."""
+        return cls.from_model(spec.name, spec.description, spec.input_model)
+
+
+class ChatRequest(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+
+    system: str = ""
+    messages: List[Message]
+    tools: List[ToolSpecLLM] = Field(default_factory=list)
+    output_model: Optional[Type[BaseModel]] = None  # forces a JSON answer validated into this model
+    max_tokens: Optional[int] = Field(default=None, ge=1)
+    effort: Optional[Effort] = None
+    task: Task = "chat"
+    cache: bool = True
+    cache_ttl: Literal["5m", "1h"] = "5m"
+    model: Optional[str] = None  # overrides the configured model for this one call
+
+
+class Usage(BaseModel):
+    input_tokens: int = 0       # uncached input
+    output_tokens: int = 0
+    cache_read_tokens: int = 0
+    cache_write_tokens: int = 0
+
+    def __add__(self, other: "Usage") -> "Usage":
+        return Usage(**{k: getattr(self, k) + getattr(other, k) for k in type(self).model_fields})
+
+
+class ChatResult(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+
+    text: str = ""
+    tool_calls: List[ToolCall] = Field(default_factory=list)
+    parsed: Optional[BaseModel] = None
+    stop: StopReason = "end"
+    usage: Usage = Field(default_factory=Usage)
+    model: str = ""
+    provider: str = ""
+    message: Message                      # the final assistant turn
+    new_messages: List[Message] = Field(default_factory=list)  # everything to append, in order (see repair retry)
+    refusal_category: Optional[str] = None
+    refusal_explanation: Optional[str] = None
+
+    def model_post_init(self, __context: Any) -> None:
+        if not self.new_messages:
