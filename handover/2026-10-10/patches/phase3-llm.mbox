+           "usage": usage or {"input_tokens": 10, "output_tokens": 5, "cache_read_input_tokens": 100,
+                              "cache_creation_input_tokens": 20}}
+    if stop_details is not None:
+        msg["stop_details"] = stop_details
+    return msg
