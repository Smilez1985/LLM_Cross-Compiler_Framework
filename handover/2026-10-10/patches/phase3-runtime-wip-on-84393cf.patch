+# Managed local LLM runtime for Ditto's offline mode: a pinned llama.cpp build (llama-server) and
+# pinned GGUF models. This file is data: a newer build or another model is added here, not in code.
+#
+# Every download needs a pinned sha256 and is verified before it is unpacked or used; entries without
+# one are refused (fail closed). Models are pinned to a Hugging Face commit, never to a branch.
+#
+# Sources (checked 2026-10-10):
+# - llama.cpp assets: names and sizes from the release download URLs of tag b11429 (the v0.6.0 tag
+#   points at the same commit; binaries are only published under the b-number). The sha256 values were
+#   computed from complete, TLS-verified downloads of each asset because the GitHub API (whose assets
+#   carry a "digest" field) was not reachable from the session that pinned them. To cross-check:
+#   gh api repos/ggml-org/llama.cpp/releases/tags/b11429 --jq '.assets[] | [.name, .digest] | @tsv'
+# - Models: HfApi().model_info(repo, revision, files_metadata=True) -> siblings[].lfs.sha256 and size.
+schema_version: 1
+
+llama_cpp:
+  build: b11429
+  version: "0.6.0"
+  base_url: https://github.com/ggml-org/llama.cpp/releases/download/b11429/
+  # Server options that exist in this build (checked in tools/server and common/arg.cpp at the tag).
+  features:
+    sleep_idle_seconds: true
+    fit: true
+  # CUDA minor-version compatibility (NVIDIA CUDA Toolkit release notes, table 3): 13.x needs driver
+  # >= 580 and dropped GPUs before Turing (compute capability < 7.5); 12.x runs on drivers >= 525.
+  assets:
+    # --- Linux x86_64 ---
+    - id: linux-x64-cpu
+      os: linux
+      arch: x86_64
+      backend: cpu
+      files:
+        - {name: llama-b11429-bin-ubuntu-x64.tar.gz, size: 17693462, sha256: f6d25dde8f51133143d1453da4fd5f73b145127177612a283bf7995957af3392}
+    - id: linux-x64-vulkan
+      os: linux
+      arch: x86_64
+      backend: vulkan
+      files:
+        - {name: llama-b11429-bin-ubuntu-vulkan-x64.tar.gz, size: 31636673, sha256: 632c4e98feba2b94407a2130e3133e0c3aefb0ea1ab41337e926d8bfafdd0b74}
+    - id: linux-x64-cuda-13.4
+      os: linux
+      arch: x86_64
+      backend: cuda
+      cuda: "13.4"
+      min_driver: 580
+      min_compute_cap: 7.5
+      files:
+        - {name: llama-b11429-bin-ubuntu-cuda-13.4-x64.tar.gz, size: 152519318, sha256: 8082b7eaa74a714c9fecca19128f751c8e32da763ee8096b8ad1e824da7621d3}
+    - id: linux-x64-cuda-12.8
+      os: linux
+      arch: x86_64
+      backend: cuda
+      cuda: "12.8"
+      min_driver: 525
+      min_compute_cap: 5.0
+      files:
+        - {name: llama-b11429-bin-ubuntu-cuda-12.8-x64.tar.gz, size: 171651873, sha256: b13c64b9224d3c89d9993945d70cc21177ad00178c21b8d34237e3bc139834f1}
+    - id: linux-x64-rocm-10.0
+      os: linux
+      arch: x86_64
+      backend: rocm
+      opt_in: true   # only when asked for: needs a matching ROCm installation and a supported GPU
+      files:
+        - {name: llama-b11429-bin-ubuntu-rocm-10.0-x64.tar.gz, size: 243892368, sha256: bd73e52146551f07a4c539bbe9da42f3b680c44ddc252fce61ab86d567a5932a}
+
+    # --- Linux arm64 ---
+    - id: linux-arm64-cpu
+      os: linux
+      arch: arm64
+      backend: cpu
+      files:
+        - {name: llama-b11429-bin-ubuntu-arm64.tar.gz, size: 13682895, sha256: ed44c0f79c3d02424f62bdc87e106318b0b89f49050e2e80c5f352723d14e00b}
+    - id: linux-arm64-vulkan
+      os: linux
+      arch: arm64
+      backend: vulkan
+      files:
+        - {name: llama-b11429-bin-ubuntu-vulkan-arm64.tar.gz, size: 24845090, sha256: 702d99c4219b4314cc6d3b10fb41ae96cbfc68226305c2681269dfb51487af34}
+
+    # --- Windows x86_64 ---
+    - id: windows-x64-cpu
+      os: windows
+      arch: x86_64
+      backend: cpu
+      files:
+        - {name: llama-b11429-bin-win-cpu-x64.zip, size: 19398918, sha256: 1283323272b04cd07905816a597a0da810918102de958f4ff6f7bbaa70ed2efe}
+    - id: windows-x64-vulkan
+      os: windows
+      arch: x86_64
+      backend: vulkan
+      files:
+        - {name: llama-b11429-bin-win-vulkan-x64.zip, size: 33337769, sha256: 1bfe78ad9168b79fa02bf67f6af9f5e17a966d824d77238517f7bef12ac73b36}
+    - id: windows-x64-cuda-13.4
+      os: windows
+      arch: x86_64
+      backend: cuda
+      cuda: "13.4"
+      min_driver: 580
+      min_compute_cap: 7.5
+      files:   # the CUDA runtime DLLs ship as a separate archive and go into the same folder
+        - {name: llama-b11429-bin-win-cuda-13.4-x64.zip, size: 153089864, sha256: 76ddc6eff2389570789ed608881efc6977751a722015d8e8c94f302224ff1a3a}
+        - {name: cudart-llama-bin-win-cuda-13.4-x64.zip, size: 423535356, sha256: 738f8c251ac22b70c3ae6f83a10cf222725df0395246a2cf58f32bdb85fbe668}
+    - id: windows-x64-cuda-12.4
+      os: windows
+      arch: x86_64
+      backend: cuda
+      cuda: "12.4"
+      min_driver: 525
+      min_compute_cap: 5.0
+      files:
+        - {name: llama-b11429-bin-win-cuda-12.4-x64.zip, size: 264478423, sha256: dd6df685c1024e6aa55ca55ad35038692d5e284d4dc895e7a646c3245d3d14ff}
+        - {name: cudart-llama-bin-win-cuda-12.4-x64.zip, size: 391443627, sha256: 8c79a9b226de4b3cacfd1f83d24f962d0773be79f1e7b75c6af4ded7e32ae1d6}
+    - id: windows-x64-rocm-10.0
+      os: windows
+      arch: x86_64
+      backend: rocm
+      opt_in: true
+      files:
+        - {name: llama-b11429-bin-win-rocm-10.0-x64.zip, size: 256958369, sha256: 289a8453bb222f0648f91eff3d55133c934119c841eb369b704aafae1d4719d2}
+
+    # --- Windows arm64 ---
+    - id: windows-arm64-cpu
+      os: windows
+      arch: arm64
+      backend: cpu
+      files:
+        - {name: llama-b11429-bin-win-cpu-arm64.zip, size: 12229035, sha256: ee0f631a9e58b146ff50714099d9cb498906af3143a773b580093a9214a8d1e5}
+
+    # --- macOS (Apple Silicon builds include Metal) ---
+    - id: macos-arm64-metal
+      os: macos
+      arch: arm64
+      backend: metal
+      files:
+        - {name: llama-b11429-bin-macos-arm64.tar.gz, size: 11971406, sha256: 740288ec6887be94280a5dfa25b5e23a78285cab104519e6c7e218904ee82459}
+    - id: macos-x64-cpu
+      os: macos
+      arch: x86_64
+      backend: cpu
+      files:
+        - {name: llama-b11429-bin-macos-x64.tar.gz, size: 11487431, sha256: 29ac3ea02be6bd143e824973f2cc5fa74bc4094393a9eaab0ff6814f19dd8522}
+
+# Server defaults. The context is computed from free memory and the model, then capped here;
+# the models' native context (up to 262144 tokens) would not fit on a desktop.
+server:
+  ctx_cap: 32768
+  ctx_min: 4096
+  sleep_idle_seconds: 600   # unload the model after 10 idle minutes (0 = never); reloads on the next request
+  health_timeout_seconds: 300
+
+# Ditto models. kv_bytes_per_token: f16 KV cache per token, 2 (K,V) * attention layers * KV heads *
+# head dim * 2 bytes, from the base model's config.json (Qwen3.5 has full attention in 1 of 4 layers).
+models:
+  - tier: small
+    repo: unsloth/Qwen3.5-2B-GGUF
+    revision: f6d5376be1edb4d416d56da11e5397a961aca8ae
+    file: Qwen3.5-2B-Q4_K_M.gguf
+    size: 1280835840
+    sha256: aaf42c8b7c3cab2bf3d69c355048d4a0ee9973d48f16c731c0520ee914699223
+    license: apache-2.0
+    native_context: 262144
+    kv_bytes_per_token: 12288    # 6 full-attention layers * 2 KV heads * 256
+    description: Qwen3.5 2B (Q4_K_M) for machines with up to 4 GB RAM
+
+  - tier: default
+    repo: unsloth/Qwen3.5-4B-GGUF
+    revision: e87f176479d0855a907a41277aca2f8ee7a09523
+    file: Qwen3.5-4B-Q4_K_M.gguf
+    size: 2740937888
+    sha256: 00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4
+    license: apache-2.0
+    native_context: 262144
+    kv_bytes_per_token: 32768    # 8 full-attention layers * 4 KV heads * 256
+    description: Qwen3.5 4B (Q4_K_M), the default
+
+  - tier: large
+    repo: unsloth/Qwen3.5-9B-GGUF
+    revision: 3885219b6810b007914f3a7950a8d1b469d598a5
+    file: Qwen3.5-9B-Q4_K_M.gguf
+    size: 5680522464
+    sha256: 03b74727a860a56338e042c4420bb3f04b2fec5734175f4cb9fa853daf52b7e8
+    license: apache-2.0
+    native_context: 262144
+    kv_bytes_per_token: 32768
+    description: Qwen3.5 9B (Q4_K_M) for GPUs with 8 GB VRAM or more (e.g. RTX 2080 Ti, RTX 3090)
+
+  - tier: large-iq2
+    on_request: true
+    repo: unsloth/Qwen3.5-9B-GGUF
+    revision: 3885219b6810b007914f3a7950a8d1b469d598a5
+    file: Qwen3.5-9B-UD-IQ2_M.gguf
+    size: 3649365216
+    sha256: a31b6b4c603ddd66b5496ee065c9dd13b2b6de77dce9e5d59609aef8d39868e7
+    license: apache-2.0
+    native_context: 262144
+    kv_bytes_per_token: 32768
+    description: Qwen3.5 9B at 2-bit (UD-IQ2_M), only on request; noticeably less accurate
+
+  - tier: granite
+    on_request: true
+    repo: ibm-granite/granite-4.2-3b-GGUF
+    revision: c40945d71cd90f249a56985e8155551a9188dc30
+    file: granite-4.2-3b-Q4_K_M.gguf
+    size: 2244011552
+    sha256: e0406663965846ae22a403456eb826ccce5f450840491f71952f18a7cb78e7d5
+    license: apache-2.0
+    native_context: 131072
+    kv_bytes_per_token: 81920    # 40 layers * 8 KV heads * 64
+    description: IBM Granite 4.2 3B (Q4_K_M), fallback model family
+
+# Automatic tier choice: the first rule whose conditions all hold wins (GiB; machines sold with 4 GB
+# report about 3.6-3.9 GiB). VRAM counts only when a GPU backend was selected.
+tier_rules:
+  - {tier: large, min_vram_gib: 7.5}
+  - {tier: small, max_ram_gib: 4.5}
+  - {tier: default}
